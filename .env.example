# Copy these into Hostinger: Website → Node.js → Environment variables
# Staff screens (ops, unit, governor, map, reports, admin) need this user/password. Leave empty = no protection.
DEMO_USER=admin
DEMO_PASSWORD=change-me-to-a-long-password
# Keep data outside the code folder so redeploys don't wipe reports and uploads (absolute path on the server)
DATA_DIR=/home/YOUR_HOSTINGER_USER/ballegh-data
# PORT is set by Hostinger automatically
